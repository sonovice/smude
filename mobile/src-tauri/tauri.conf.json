{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Smude",
  "version": "2.0.0-alpha.1",
  "identifier": "com.notavium.smude.tauri",
  "build": {
    "beforeDevCommand": "node prepare-runtime.mjs && npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "node prepare-runtime.mjs && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Smude",
        "width": 440,
        "height": 860,
        "backgroundColor": "#181919"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost blob:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; font-src 'self'; object-src 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPCACHE/**",
          "$APPDATA/**",
          "$DOCUMENT/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/icon.png"
    ],
    "android": {
      "minSdkVersion": 28
    },
    "iOS": {
      "minimumSystemVersion": "16.0",
      "developmentTeam": "76CP95AA8F",
      "bundleVersion": "1"
    }
  }
}
