    android:insetLeft="19.444444%" android:insetTop="19.444444%"
    android:insetRight="19.444444%" android:insetBottom="19.444444%">
    <bitmap android:src="@drawable/launcher_artwork"
        android:gravity="fill" android:filter="true" />
</inset>
